{
  "name": "rakuten",
  "private": true,
  "type": "module",
  "scripts": {
    "lint": "oxlint --deny-warnings",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "dev": "pnpm --filter web dev",
    "build": "pnpm --filter web build",
    "type:check": "pnpm -r exec tsc --noEmit",
    "spell:check": "cspell .",
    "test": "vitest run",
    "build:e2e": "RAKUTEN_ITEM_SEARCH_FIXTURE=e2e/item-search-fixture.json PUBLIC_RAKUTEN_APPLICATION_ID=e2e-application-id PUBLIC_RAKUTEN_ACCESS_KEY=e2e-access-key PUBLIC_RAKUTEN_AFFILIATE_ID=e2e-affiliate-id pnpm build",
    "test:e2e": "pnpm build:e2e && pnpm --filter web exec playwright test",
    "check:all": "pnpm lint && pnpm fmt:check && pnpm type:check && pnpm spell:check && pnpm test"
  },
  "devDependencies": {
    "@dotenvx/dotenvx": "2.33.0",
    "cspell": "10.3.6",
    "oxfmt": "0.71.0",
    "oxlint": "1.86.0",
    "typescript": "7.0.2",
    "vitest": "5.0.3"
  },
  "packageManager": "pnpm@12.9.1"
}
