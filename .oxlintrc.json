{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "import"],
  "jsPlugins": ["./apps/web/lint/jotai-plugin.ts", "./packages/ui/lint/style-plugin.ts"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "import/extensions": [
      "error",
      "always",
      {
        "ignorePackages": true
      }
    ]
  },
  "overrides": [
    {
      "files": ["apps/web/src/**"],
      "plugins": ["react"],
      "rules": {
        "react/rules-of-hooks": "error",
        "react/exhaustive-deps": "error",
        "react/error-boundaries": "error",
        "react/globals": "error",
        "react/immutability": "error",
        "react/incompatible-library": "error",
        "react/preserve-manual-memoization": "error",
        "react/purity": "error",
        "react/refs": "error",
        "react/rule-suppression": "error",
        "react/set-state-in-effect": "error",
        "react/set-state-in-render": "error",
        "react/static-components": "error",
        "react/unsupported-syntax": "error",
        "react/use-memo": "error",
        "jotai/no-callback-only-subscription": "error",
        "yamada/no-conditional-style": "error",
        "yamada/no-raw-selector": "error"
      }
    },
    {
      "files": ["apps/web/src/**", "packages/domain/src/**"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "group": ["../**"],
                "message": "親ディレクトリのモジュールは `#/`（package.json の imports）から読み込む。"
              }
            ]
          }
        ]
      }
    }
  ],
  "env": {
    "builtin": true
  },
  "ignorePatterns": [
    "node_modules/**",
    "coverage/**",
    ".superpowers/**",
    ".claude/**",
    "docs/**",
    "**/routeTree.gen.ts",
    "**/dist/**"
  ]
}
